    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "eslint": "^8.57.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.1",
    "vite-plugin-svgr": "^4.2.0",
    "vite-tsconfig-paths": "^4.3.1"
